# Copy to .env for local development. In Azure these come from the Container App
# environment and Key Vault (see infra/main.bicep).

# Audit database
DATABASE_URL=postgresql://audit:audit@localhost:5432/audit_dev

# 'fixtures' runs on built-in demo data; 'live' reads HubSpot and the Control Panel
SOURCE_MODE=fixtures

# Control Panel read replica (read-only role, see docs/control-panel-views.sql)
CONTROL_PANEL_DATABASE_URL=
CONTROL_PANEL_SCHEMA=audit

# HubSpot private app token (scopes: crm.objects.companies.read, crm.objects.owners.read, tasks write)
HUBSPOT_TOKEN=
# Internal names of your HubSpot company properties (defaults shown)
# HS_PROP_CONTROL_PANEL_ID=control_panel_id
# HS_PROP_CSM_NAME=csm_name
# HS_PROP_CSM_EMAIL=csm_email
# HS_PROP_INDUSTRY=industry
# HS_PROP_CONTRACT_END=contract_end_date
# HS_PROP_SEAT_TIER=seat_tier
# HS_PROP_PAID_SEATS=paid_seats
# HS_PROP_ARR=arr_ngn
# HS_PROP_PRICE_PER_SEAT=price_per_seat_monthly_ngn
# HS_PROP_HEALTH=health_status
# HS_CUSTOMER_LIFECYCLE_STAGE=customer

# US-01 seat count: hubspot_paid_seats (contract) or control_panel_active_users (usage)
ARR_SEAT_SOURCE=hubspot_paid_seats

# Alerts
ALERT_CHANNELS=google_chat,email,hubspot_task
ALERTS_DRY_RUN=true
GOOGLE_CHAT_DEFAULT_WEBHOOK=
FALLBACK_ALERT_EMAILS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

APP_BASE_URL=http://localhost:8080
ACK_LINK_SECRET=dev-only-change-me-please

# Shown as "Get help" on the sign-in screen (optional)
HELP_EMAIL=

# Google Workspace sign-in for the API
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_WORKSPACE_DOMAIN=
AUTH_DISABLED=true

# Claude write-ups on alerts (optional)
AI_RATIONALE_ENABLED=false
# Onboarding playbooks, ticket themes, QBR drafts, tone scoring (phase 4)
AI_FEATURES_ENABLED=false
AI_MAX_ITEMS_PER_RUN=40
CLAUDE_PROVIDER=foundry
CLAUDE_MODEL=claude-opus-5-5
# ANTHROPIC_FOUNDRY_RESOURCE=
# ANTHROPIC_FOUNDRY_API_KEY=
# ANTHROPIC_API_KEY=            # when CLAUDE_PROVIDER=anthropic

# HubSpot tickets and contact (phase 3/4)
HS_TICKET_CLOSED_STAGE_IDS=4
HS_TICKET_LOOKBACK_DAYS=120
HS_PROP_PRIMARY_CONTACT_EMAIL=

# Admin broadcasts. false = dry run: recorded, nothing sent.
BROADCASTS_LIVE=false
BROADCAST_MAX_RECIPIENTS=200
BROADCAST_SEND_DELAY_MS=250
BROADCAST_REQUIRE_CP_ADMIN=false
